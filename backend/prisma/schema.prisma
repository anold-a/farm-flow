// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  AGENT
}

model User {
  id        String   @id @default(uuid())
  fullName  String
  email     String   @unique
  password  String
  role      Role     @default(AGENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdFields  Field[] @relation("FieldCreatedBy")
  assignedFields Field[] @relation("FieldAssignedAgent")

  fieldUpdates  FieldUpdate[]
  notifications Notification[]
}

model Field {
  id String @id @default(uuid())

  name     String
  crop     String
  location String
  acreage  Float
  status   String

  createdById String
  createdBy   User   @relation("FieldCreatedBy", fields: [createdById], references: [id])

  assignedAgentId String?
  assignedAgent   User?   @relation("FieldAssignedAgent", fields: [assignedAgentId], references: [id])

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  fieldUpdates FieldUpdate[]

  crops  Crop[]
  alerts Alert[]
}

model FieldUpdate {
  id String @id @default(uuid())

  cropStage   String
  notes       String
  moisture    Float?
  temperature Float?
  humidity    Float?

  fieldId String
  field   Field  @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id String @id @default(uuid())

  title   String
  message String
  type    String

  isRead Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

enum GrowthStage {
  PLANTED
  GERMINATION
  VEGETATIVE
  FLOWERING
  FRUITING
  HARVEST_READY
  HARVESTED
}

model Crop {
  id String @id @default(uuid())

  name    String
  variety String

  plantingDate        DateTime
  expectedHarvestDate DateTime

  growthStage GrowthStage @default(PLANTED)

  fieldId String
  field   Field  @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

model Alert {
  id String @id @default(uuid())

  fieldId String
  field   Field  @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  type     String
  severity AlertSeverity
  message  String

  resolved Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
