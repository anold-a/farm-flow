// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  AGENT
}

model User {
  id        String   @id @default(uuid())
  fullName  String
  email     String   @unique
  password  String
  role      Role     @default(AGENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdFields  Field[] @relation("FieldCreatedBy")
  assignedFields Field[] @relation("FieldAssignedAgent")

  fieldUpdates FieldUpdate[]
}

model Field {
  id String @id @default(uuid())

  name     String
  crop     String
  location String
  acreage  Float
  status   String

  createdById String
  createdBy   User   @relation("FieldCreatedBy", fields: [createdById], references: [id])

  assignedAgentId String?
  assignedAgent   User?   @relation("FieldAssignedAgent", fields: [assignedAgentId], references: [id])

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  fieldUpdates FieldUpdate[]
}

model FieldUpdate {
  id String @id @default(uuid())

  cropStage   String
  notes       String
  moisture    Float?
  temperature Float?
  humidity    Float?

  fieldId String
  field   Field  @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
